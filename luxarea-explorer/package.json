{
  "name": "luxarea-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p api && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p api",
    "test": "node scripts/run-tests.mjs",
    "scan:dry": "esbuild scripts/scan-dry-run.ts --bundle --platform=node --format=esm --packages=external --define:import.meta.env={} --log-level=error --outfile=test-build/scan-dry-run.mjs && node test-build/scan-dry-run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@supabase/supabase-js": "2.45.4",
    "lenis": "1.1.13",
    "maplibre-gl": "4.7.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
